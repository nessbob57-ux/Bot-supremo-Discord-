// Bot Supremo Discord — Prisma schema
// Multi-tenant SaaS: comércio, pagamentos, assinaturas, afiliados, gamificação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT
// ============================================================================
model Tenant {
  id          String   @id @default(cuid())
  discordGuildId String? @unique
  name        String
  slug        String   @unique
  plan        TenantPlan @default(FREE)
  isActive    Boolean  @default(true)
  whiteLabel  Boolean  @default(false)
  subdomain   String?  @unique
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  products      Product[]
  orders        Order[]
  subscriptions Subscription[]
  coupons       Coupon[]
  campaigns     Campaign[]
  featureFlags  FeatureFlag[]
  events        EventLog[]
  plans         Plan[]
  affiliates    Affiliate[]
  categories    Category[]
  webhooks      Webhook[]

  @@index([slug])
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ============================================================================
// USERS
// ============================================================================
model User {
  id            String   @id @default(cuid())
  tenantId      String
  discordId     String
  username      String
  email         String?
  trustScore    Float    @default(50)
  isBanned      Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  language      String   @default("pt-BR")
  segment       String?
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  lastActiveAt  DateTime @default(now())
  consentLGPD   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carts         Cart[]
  orders        Order[]
  payments      Payment[]
  subscriptions Subscription[]
  wallet        Wallet?
  affiliate     Affiliate?
  achievements  UserAchievement[]
  missions      UserMission[]
  events        EventLog[]
  reviews       Review[]
  notifications Notification[]
  audits        AuditLog[]

  @@unique([tenantId, discordId])
  @@index([discordId])
  @@index([tenantId, segment])
}

// ============================================================================
// PRODUCT CATALOG
// ============================================================================
model Category {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, slug])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  categoryId    String?
  name          String
  slug          String
  sku           String?
  shortDesc     String?
  longDesc      String?
  type          ProductType  @default(DIGITAL)
  priceCents    Int
  compareAtCents Int?
  currency      String   @default("BRL")
  stock         Int      @default(0)
  unlimited     Boolean  @default(false)
  minPerUser    Int      @default(1)
  maxPerUser    Int?
  hidden        Boolean  @default(false)
  exclusive     Boolean  @default(false)
  featured      Boolean  @default(false)
  isFree        Boolean  @default(false)
  isRecurring   Boolean  @default(false)
  isBundle      Boolean  @default(false)
  isSecret      Boolean  @default(false)
  isPreorder    Boolean  @default(false)
  releaseAt     DateTime?
  expiresAt     DateTime?
  deliveryMode  DeliveryMode @default(AUTOMATIC)
  images        String[]
  tags          String[]
  metadata      Json     @default("{}")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  bundleItems BundleItem[]   @relation("BundleParent")
  inBundles   BundleItem[]   @relation("BundleChild")
  waitlist    Waitlist[]
  reviews     Review[]

  @@unique([tenantId, slug])
  @@index([tenantId, active, hidden])
  @@index([tenantId, featured])
}

enum ProductType {
  DIGITAL
  PHYSICAL
  SERVICE
  SUBSCRIPTION
}

enum DeliveryMode {
  AUTOMATIC
  MANUAL
  SCHEDULED
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  sku        String?
  priceDelta Int      @default(0)
  stock      Int      @default(0)
  metadata   Json     @default("{}")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BundleItem {
  id              String  @id @default(cuid())
  bundleProductId String
  childProductId  String
  quantity        Int     @default(1)

  bundle Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  child  Product @relation("BundleChild", fields: [childProductId], references: [id])

  @@unique([bundleProductId, childProductId])
}

model Waitlist {
  id        String   @id @default(cuid())
  productId String
  userId    String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// CART
// ============================================================================
model Cart {
  id          String   @id @default(cuid())
  userId      String
  status      CartStatus @default(ACTIVE)
  couponId    String?
  abandonedAt DateTime?
  recoveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
  coupon Coupon?    @relation(fields: [couponId], references: [id])

  @@index([userId, status])
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CHECKED_OUT
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  priceCents Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// ============================================================================
// ORDERS
// ============================================================================
model Order {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  number          Int
  status          OrderStatus @default(PENDING)
  totalCents      Int
  subtotalCents   Int
  discountCents   Int      @default(0)
  taxCents        Int      @default(0)
  couponCode      String?
  affiliateId     String?
  notes           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payments  Payment[]
  affiliate Affiliate? @relation(fields: [affiliateId], references: [id])
  refunds   Refund[]
  delivery  Delivery?

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([userId, status])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
  EXPIRED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  priceCents  Int
  totalCents  Int
  metadata    Json    @default("{}")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Delivery {
  id          String   @id @default(cuid())
  orderId     String   @unique
  status      DeliveryStatus @default(PENDING)
  payload     Json     @default("{}")
  deliveredAt DateTime?
  attempts    Int      @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SCHEDULED
}

// ============================================================================
// PAYMENTS
// ============================================================================
model Payment {
  id              String   @id @default(cuid())
  orderId         String?
  userId          String
  amountCents     Int
  currency        String   @default("BRL")
  method          PaymentMethod @default(PIX)
  status          PaymentStatus @default(PENDING)
  externalId      String?
  pixCode         String?
  qrCodeData      String?
  attempts        Int      @default(0)
  failureReason   String?
  expiresAt       DateTime?
  paidAt          DateTime?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  WALLET
  CRYPTO
  EXTERNAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  amountCents Int
  reason      String?
  full        Boolean  @default(true)
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TransactionType
  amountCents Int
  currency    String   @default("BRL")
  description String?
  referenceId String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

enum TransactionType {
  PURCHASE
  REFUND
  WALLET_DEPOSIT
  WALLET_WITHDRAW
  AFFILIATE_COMMISSION
  CASHBACK
  TIP
  DONATION
  FEE
  ADJUSTMENT
}

// ============================================================================
// WALLET (créditos internos)
// ============================================================================
model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balanceCents Int     @default(0)
  currency    String   @default("BRL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements WalletMovement[]
}

model WalletMovement {
  id          String   @id @default(cuid())
  walletId    String
  amountCents Int
  type        WalletMovementType
  description String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

enum WalletMovementType {
  CREDIT
  DEBIT
}

// ============================================================================
// SUBSCRIPTIONS
// ============================================================================
model Plan {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  slug          String
  priceCents    Int
  currency      String   @default("BRL")
  interval      PlanInterval @default(MONTHLY)
  trialDays     Int      @default(0)
  roleId        String?
  benefits      String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([tenantId, slug])
}

enum PlanInterval {
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
}

model Subscription {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  startedAt       DateTime @default(now())
  trialEndsAt     DateTime?
  renewsAt        DateTime?
  cancelledAt     DateTime?
  pausedAt        DateTime?
  expiresAt       DateTime?
  failedAttempts  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status, renewsAt])
  @@index([userId, status])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

// ============================================================================
// MARKETING
// ============================================================================
model Coupon {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  description  String?
  type         CouponType  @default(PERCENT)
  value        Int
  minOrderCents Int     @default(0)
  maxUses      Int?
  uses         Int      @default(0)
  perUserLimit Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carts  Cart[]

  @@unique([tenantId, code])
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Campaign {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  type         CampaignType
  segment      String?
  message      String
  scheduledAt  DateTime?
  status       CampaignStatus @default(DRAFT)
  metrics      Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum CampaignType {
  BROADCAST
  EMAIL
  DM
  CHANNEL
  AUTOMATION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

// ============================================================================
// AFFILIATES
// ============================================================================
model Affiliate {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String   @unique
  code          String   @unique
  commissionPct Float    @default(10)
  totalEarned   Int      @default(0)
  paidOut       Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

// ============================================================================
// GAMIFICATION
// ============================================================================
model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  xpReward    Int      @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Mission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  xpReward    Int      @default(0)
  rewardCents Int      @default(0)
  goal        Int      @default(1)
  active      Boolean  @default(true)

  users UserMission[]
}

model UserMission {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId])
}

// ============================================================================
// FEATURE FLAGS / EVENTS / AUDIT
// ============================================================================
model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String?
  key       String
  enabled   Boolean  @default(false)
  rollout   Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model EventLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorType String   @default("user")
  action    String
  resource  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  events    String[]
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
