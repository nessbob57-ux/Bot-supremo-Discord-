# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=Bot Supremo Discord
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bot_supremo?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=optional_dev_guild_id_for_fast_command_sync

# JWT (for REST API)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Payment provider (simulated/stubbed by default)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me_in_production
PIX_KEY=mock_pix_key@example.com

# Feature flags / multi-tenant
DEFAULT_TENANT_ID=default
ENABLE_AFFILIATE_SYSTEM=true
ENABLE_GAMIFICATION=true
ENABLE_MARKETPLACE=true

# Observability
LOG_LEVEL=info
